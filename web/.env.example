# Leapter Runtime — default config (used when no devtools override is set)
#
# Local dev: leave unset — each project uses its own URL automatically.
# Production: set to your hosted Leapter runtime URL.

# Leapter API Key — not needed for local dev
# LEAPTER_API_KEY=lpt_...

# Leapter Devtools & Glass Mode — enabled by default.
# Set to "false" to disable the devtools panel and Glass Mode trace viewer.
# NEXT_PUBLIC_LEAPTER_DEV_MODE=false
